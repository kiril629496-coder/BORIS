#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo "ERROR: run as root" >&2
  exit 2
fi

archive="${1:-}"
manifest="${2:-}"
if [ -z "$archive" ] || [ -z "$manifest" ]; then
  echo "usage: deploy-full-release <archive.tar.gz> <manifest.json>" >&2
  exit 2
fi

base=/opt/uasaaap
app=/srv/uasaaap
nodebin=/opt/uasaaap/runtime/node-v24.8.0-linux-x64/bin
nginx_active=/etc/nginx/sites-available/uasaaap
nginx_next=/etc/nginx/sites-available/uasaaap.next
release_env=/etc/systemd/system/uasaaap.service.d/99-release.conf

"$base/bin/validate-artifact" "$archive" "$manifest" >/tmp/uasaaap-validate.json

stage_json="$("$base/bin/stage-artifact" "$archive" "$manifest")"
stage_path="$(printf '%s' "$stage_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["stage_path"])')"
"$base/bin/release-gate" "$stage_path" >/tmp/uasaaap-release-gate.json

head="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["head"])' "$manifest")"

# A deployment may only activate after a fresh encrypted backup of the live DB.
systemctl daemon-reload
backup_started="$(date +%s)"
systemctl start uasaaap-backup.service
backup_file="$(find "$app/backups" -maxdepth 1 -type f -name 'marketplace-*.sqlite.enc' -printf '%T@ %p\n' | sort -nr | sed -n '1p' | cut -d' ' -f2-)"
test -n "$backup_file"
backup_mtime="$(stat -c %Y "$backup_file")"
test "$backup_mtime" -ge "$backup_started"
sha256sum "$backup_file" > "$backup_file.sha256"
chmod 600 "$backup_file.sha256"
chown uasaaap:uasaaap "$backup_file.sha256"

release_id="${head:0:12}-$(date -u +%Y%m%dT%H%M%SZ)"
dest="$app/releases/$release_id"
src="$stage_path/src"

if [ -e "$dest" ]; then
  echo "ERROR: release exists $dest" >&2
  exit 3
fi

install -d -m 755 "$app/releases"
install -d -m 700 "$app/shared/data" "$app/backups"
cp -a "$src" "$dest"

# Runtime state is persistent and never tied to a code release.
rm -rf "$dest/data"
ln -s "$app/shared/data" "$dest/data"
chown -R uasaaap:uasaaap "$dest" "$app/shared" "$app/backups"

# Install only runtime dependencies using the isolated Node 24 runtime.
runuser -u uasaaap -- env PATH="$nodebin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
  "$nodebin/npm" --prefix "$dest" ci --omit=dev --ignore-scripts

test -s "$dest/dist/index.html"
test -f "$dest/server/marketplace/index.js"
test -f "$dest/package.json"

prev_current="$(readlink -f "$app/current" 2>/dev/null || true)"
if [ -n "$prev_current" ] && [ -d "$prev_current" ]; then
  ln -sfn "$prev_current" "$app/previous"
fi
prev_nginx="/etc/nginx/sites-available/uasaaap.rollback.$(date -u +%Y%m%dT%H%M%SZ)"
cp -a "$nginx_active" "$prev_nginx"
release_env_backup="/tmp/uasaaap-release-env.$$.bak"
release_env_existed=0
if [ -f "$release_env" ]; then
  cp -a "$release_env" "$release_env_backup"
  release_env_existed=1
fi

rollback() {
  code=$?
  echo "ROLLBACK triggered code=$code" >&2
  cp -a "$prev_nginx" "$nginx_active" || true
  if [ "$release_env_existed" -eq 1 ]; then
    cp -a "$release_env_backup" "$release_env" || true
  else
    rm -f "$release_env" || true
  fi
  systemctl daemon-reload || true
  if [ -n "$prev_current" ] && [ -d "$prev_current" ]; then
    ln -sfn "$prev_current" "$app/current"
    systemctl restart uasaaap.service || true
  else
    systemctl stop uasaaap.service || true
    rm -f "$app/current"
  fi
  nginx -t >/tmp/uasaaap-nginx-rollback.log 2>&1 && systemctl reload nginx || true
  exit "$code"
}
trap rollback ERR

ln -sfn "$dest" "$app/current"

install -d -m 755 "$(dirname "$release_env")"
cat > "$release_env" <<EOF
[Service]
Environment=RELEASE_SHA=$head
Environment=CANONICAL_HEAD=$head
EOF
chmod 644 "$release_env"

systemctl daemon-reload
systemctl enable uasaaap.service >/dev/null 2>&1 || true
effective_env="$(systemctl show uasaaap.service -p Environment --value)"
case " $effective_env " in
  *" RELEASE_SHA=$head "*) ;;
  *) echo "ERROR: systemd release env did not converge to $head" >&2; false ;;
esac
systemctl restart uasaaap.service

for i in $(seq 1 30); do
  if curl -fsS --max-time 3 http://127.0.0.1:4173/api/v2/health >/tmp/uasaaap-local-health.json 2>/dev/null; then
    observed="$(python3 -c 'import json; print(json.load(open("/tmp/uasaaap-local-health.json", encoding="utf-8")).get("release", ""))' 2>/dev/null || true)"
    if [ "$observed" = "$head" ]; then
      break
    fi
  fi
  sleep 1
done
curl -fsS --max-time 5 http://127.0.0.1:4173/api/v2/health >/tmp/uasaaap-local-health.json
python3 - "$head" /tmp/uasaaap-local-health.json <<'PY'
import json, sys
expected, path = sys.argv[1:3]
data = json.load(open(path, encoding='utf-8'))
actual = data.get('release')
if actual != expected:
    raise SystemExit(f'local runtime release mismatch: expected={expected} actual={actual}')
if data.get('ok') is not True:
    raise SystemExit('local health not ok')
PY
curl -fsS --max-time 5 http://127.0.0.1:4173/api/v2/health/live >/tmp/uasaaap-local-live.json
curl -fsS --max-time 5 http://127.0.0.1:4173/api/v2/health/ready >/tmp/uasaaap-local-ready.json
python3 - "$head" /tmp/uasaaap-local-live.json /tmp/uasaaap-local-ready.json <<'PY'
import json, sys
expected = sys.argv[1]
for path in sys.argv[2:]:
    data = json.load(open(path, encoding='utf-8'))
    if data.get('release') != expected:
        raise SystemExit(f'runtime release mismatch in {path}: {data.get("release")} != {expected}')
    if data.get('ok') is not True:
        raise SystemExit(f'runtime gate not ok: {path}')
PY

cp -a "$nginx_next" "$nginx_active"
nginx -t
systemctl reload nginx

root_code="$(curl -ksS -o /tmp/uasaaap-public-root.html -w '%{http_code}' --resolve uasaaap.ru:443:127.0.0.1 https://uasaaap.ru/)"
health_code="$(curl -ksS -o /tmp/uasaap-public-health.json -w '%{http_code}' --resolve uasaaap.ru:443:127.0.0.1 https://uasaaap.ru/api/v2/health)"
test "$root_code" = "200"
test "$health_code" = "200"
grep -q '<div id="root">' /tmp/uasaaap-public-root.html

boris_code="$(curl -ksS -o /dev/null -w '%{http_code}' --max-time 15 https://boris-ai.pro/ || true)"
test "$boris_code" = "200"

printf '%s\n' "$head" > "$base/DEPLOYED_SOURCE_HEAD"
printf '%s\n' "$release_id" > "$base/DEPLOYED_RELEASE"
printf '%s\n' "$dest" > "$base/DEPLOYED_PATH"
date -u +%FT%TZ> "$base/DEPLOYED_AT"

trap - ERR
echo "DEPLOY_FULL_RELEASE=PASS"
echo "HEAD=$head"
echo "RELEASE=$release_id"
echo "PATH=$dest"
echo "ROOT_HTTP=$root_code"
echo "HEALTH_HTTP=$health_code"
echo "BORIS_HTTP=$boris_code"
