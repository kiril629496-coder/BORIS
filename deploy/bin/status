#!/usr/bin/env bash
set +e

echo "BLUE:"
systemctl is-active boris-backend
curl -s -o /dev/null -w "8000/docs=%{http_code}\n" \
    http://127.0.0.1:8000/docs

echo
echo "GREEN:"
systemctl is-active boris-backend-green
curl -s -o /dev/null -w "8001/docs=%{http_code}\n" \
    http://127.0.0.1:8001/docs
