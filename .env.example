# PostgreSQL
POSTGRES_USER=boris
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=boris
DATABASE_URL=postgresql://boris:change-me-local@localhost:5432/boris

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production
DEBUG=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI / LLM (optional)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Integrations (optional)
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# Yandex Direct OAuth / API v501
YANDEX_DIRECT_CLIENT_ID=
YANDEX_DIRECT_CLIENT_SECRET=
YANDEX_DIRECT_REDIRECT_URI=https://boris-ai.pro/api/direct/oauth/callback

# BORIS Phone commercial subscription.
# Leave empty until the standalone monthly price is explicitly approved.
# When empty, Phone is not exposed for paid checkout and is never activated at a fictitious price.
BORIS_PHONE_MONTHLY_PRICE_RUB=
